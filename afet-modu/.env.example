# Afet Modu — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=afet
POSTGRES_PASSWORD=afet_pass_2026

# ─── JWT ──────────────────────────────────────────────────────
# Produksiyonda mutlaka değiştirin!
JWT_SECRET=afet_modu_jwt_secret_change_me

# ─── Kafka / Event Bus ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Kafka çalışmazsa Redis Streams'e geçmek için:
# EVENT_BUS_BACKEND=redis
EVENT_BUS_BACKEND=kafka

# ─── AI / LLM ─────────────────────────────────────────────────
# OpenRouter API anahtarınızı buraya girin
# https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hackathon günü güncel model seçimi:
MODEL_PLANNER=openai/gpt-4o-mini
MODEL_COMMUNICATOR=openai/gpt-4o-mini

# ─── Sentetik Veri ────────────────────────────────────────────
SEED_CUSTOMERS=400
SEED_RANDOM_SEED=42
