{
  "version": 2,
  "name": "afet-modu-sistemi",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/afet-modu-app.html",
      "dest": "/index.html"
    },
    {
      "src": "/database.html",
      "dest": "/database.html"
    },
    {
      "src": "/api-docs.html",
      "dest": "/api-docs.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
